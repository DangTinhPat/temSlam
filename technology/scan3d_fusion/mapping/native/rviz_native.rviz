Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
    Background Color: 38; 42; 48
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground grid
      Enabled: true
      Plane: XY
      Plane Cell Count: 20
      Cell Size: 1
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/Map
      Name: Native occupancy map
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/MarkerArray
      Name: Tiny house geometry
      Enabled: true
      Topic: /environment
    - Class: rviz_default_plugins/MarkerArray
      Name: RB at mapped pose
      Enabled: true
      Topic: /robot
    - Class: rviz_default_plugins/PointCloud2
      Name: 3D occupied ToF voxels
      Enabled: true
      Topic:
        Value: /tof/occupied_voxels
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Size (m): 0.025
      Style: Spheres
      Color Transformer: AxisColor
      Axis: Z
      Min Color: 20; 95; 255
      Max Color: 255; 92; 28
      Position Transformer: XYZ
      Use Fixed Frame: true
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 12
      Focal Point: {X: 0, Y: 0, Z: 0.4}
      Pitch: 1.12
      Yaw: 0.8
      Name: 3D Orbit
Window Geometry:
  Width: 950
  Height: 900
  X: 0
  Y: 40
