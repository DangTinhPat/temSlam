Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Tool Properties
  Name: Tool Properties
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
    Background Color: 232; 231; 226
  Displays:
  - Class: rviz_default_plugins/Marker
    Name: Scanned room - original 3D mesh
    Enabled: false
    Topic:
      Value: /rb_navigation/mesh
      Reliability Policy: Reliable
      Durability Policy: Transient Local
  - Class: rviz_default_plugins/Map
    Name: Flattened 2D map - plane assumption
    Enabled: true
    Alpha: 1.0
    Color Scheme: map
    Draw Behind: false
    Topic:
      Value: /rb_navigation/map
      Reliability Policy: Reliable
      Durability Policy: Transient Local
  - Class: rviz_default_plugins/Map
    Name: Global costmap - 25 cm clearance
    Enabled: true
    Alpha: 0.3
    Color Scheme: costmap
    Draw Behind: false
    Topic:
      Value: /rb_navigation/global_costmap
      Reliability Policy: Reliable
      Durability Policy: Transient Local
  - Class: rviz_default_plugins/Map
    Name: Local window - STATIC map crop
    Enabled: false
    Alpha: 0.55
    Color Scheme: costmap
    Draw Behind: false
    Topic:
      Value: /rb_navigation/local_costmap
      Reliability Policy: Reliable
      Durability Policy: Transient Local
  - Class: rviz_default_plugins/Path
    Name: Global plan - orange
    Enabled: true
    Line Style: Billboards
    Line Width: 0.025
    Color: 208; 108; 38
    Alpha: 1
    Topic:
      Value: /rb_navigation/plan
      Reliability Policy: Reliable
      Durability Policy: Transient Local
  - Class: rviz_default_plugins/Path
    Name: Executed trajectory - teal
    Enabled: true
    Line Style: Billboards
    Line Width: 0.02
    Color: 38; 116; 109
    Alpha: 1
    Topic:
      Value: /rb_navigation/trajectory
      Reliability Policy: Reliable
      Durability Policy: Transient Local
  - Class: rviz_default_plugins/MarkerArray
    Name: Robot footprint - goal - state
    Enabled: true
    Topic:
      Value: /rb_navigation/markers
      Reliability Policy: Reliable
      Durability Policy: Transient Local
    Namespaces:
      status: false
  - Class: rviz_default_plugins/TF
    Name: TF map to base_link
    Enabled: false
    Show Names: true
    Show Axes: true
    Show Arrows: false
    Marker Scale: 0.25
  Tools:
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
  - Class: rviz_default_plugins/SetInitialPose
    Topic:
      Value: /rb_navigation/initialpose
      Reliability Policy: Reliable
      Durability Policy: Volatile
    X std deviation: 0.05
    Y std deviation: 0.05
    Theta std deviation: 0.05
  - Class: rviz_default_plugins/SetGoal
    Topic:
      Value: /rb_navigation/goal_pose
      Reliability Policy: Reliable
      Durability Policy: Volatile
  - Class: rviz_default_plugins/PublishPoint
    Topic:
      Value: /rb_navigation/stop
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Single click: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Flattened scan - 2D
      Scale: 90.0
      X: -1.7
      Y: -1.6
      Angle: 0.0
    Saved:
    - Class: rviz_default_plugins/TopDownOrtho
      Name: Top view - place pose and goal
      Scale: 120
      X: 0.5
      Y: -0.5
      Angle: 0
    - Class: rviz_default_plugins/Orbit
      Name: Whole scanned room
      Distance: 11
      Focal Point:
        X: -1.7
        Y: -1.6
        Z: 0
      Pitch: 1.0
      Yaw: -1.55
Window Geometry:
  Width: 1450
  Height: 900
